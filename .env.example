# =====================================================================
# CGS CTF — environment configuration
# Copy to .env at the repo root (local dev) or deployment platform.
# In production every value below marked (REQUIRED) must be replaced
# with a unique, unguessable secret — the backend refuses to start
# otherwise. Generate them with e.g. `openssl rand -hex 32`.
# =====================================================================

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000

# ---- Database (dev: sqlite | prod: postgres) ----
DB_DIALECT=sqlite
DB_STORAGE=./data/cgs-ctf.sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cgs_ctf
DB_USER=cgs
DB_PASSWORD=changeme

# ---- JWT (user tokens) ----
JWT_ACCESS_SECRET=dev-user-access-secret-change-me   # REQUIRED in production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-user-refresh-secret-change-me # REQUIRED in production
JWT_REFRESH_TTL_DAYS=14

# ---- Admin vault ----
JWT_ADMIN_SECRET=dev-admin-secret-change-me          # REQUIRED in production
ADMIN_USERNAME=Master                                # REQUIRED in production
ADMIN_EMAIL=admin@cyberguardiansociety.org           # REQUIRED in production
ADMIN_PASSWORD=change-this-before-deploying          # REQUIRED in production
ADMIN_PANEL_SLUG=cgs-ctrl-a7f8e2d1b9c4k6m3           # REQUIRED in production
ADMIN_FORCE_RESET=false
ADMIN_SESSION_TTL_DAYS=7
ADMIN_ACCESS_TTL=30m
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOCKOUT_MS=900000

# ---- Flag security ----
# HMAC pepper used to fingerprint flags and submissions.
FLAG_PEPPER=change-this-before-deploying             # REQUIRED in production

# ---- Security ----
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Files / attachments ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---- Misc ----
COMPETITION_NAME="CGS CTF"
LOG_DIR=./logs
